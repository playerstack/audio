{
  "name": "@playerstack/audio",
  "version": "0.1.0-alpha.0",
  "description": "A React component for playing audio with HLS, DASH and native formats",
  "main": "lib/index.js",
  "typings": "types/lib/index.d.ts",
  "scripts": {
    "postinstall": "node scripts/link-local-deps.js",
    "clean": "rimraf lib coverage *.d.ts",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "test": "jest --forceExit",
    "test:cov": "jest --coverage --forceExit",
    "build": "npm run build:lib",
    "build:lib": "builder \"./src/**/*.{js,jsx}\" --outdir=lib --format=cjs",
    "preversion": "npm run lint && npm run test",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "prepublishOnly": "npm run build",
    "postpublish": "npm run clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playerstack/audio.git"
  },
  "author": "Oscar Garcés (https://github.com/soyvillareal)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/playerstack/audio/issues"
  },
  "homepage": "https://github.com/playerstack/audio#readme",
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@playerstack/core": "alpha",
    "deepmerge": "^4.0.0",
    "memoize-one": "^5.1.1",
    "prop-types": "^15.7.2",
    "react-fast-compare": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.11",
    "@types/prop-types": "^15.7.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "auto-changelog": "^2.0.0",
    "builder": "file:./scripts/builder",
    "esbuild": "^0.20.2",
    "esbuild-jest": "^0.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^25.7.0",
    "eslint-plugin-prettier": "^5.2.1",
    "glob": "^11.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "typescript": "^5.7.3"
  },
  "auto-changelog": {
    "breakingPattern": "Breaking changes:"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.7"
  },
  "keywords": [
    "react",
    "media",
    "player",
    "audio",
    "hls",
    "dash",
    "react-component",
    "audio-player"
  ]
}
